# Trial deployment template. Copy to .env.trial and fill the blanks on this machine.
# .env.trial is ignored. Do not commit it. Do not put a real password in this file.
# Pass this file with: docker compose --env-file .env.trial -f docker/compose.trial.yml up -d
# A password used in K12_PG_DSN must be URL-safe: letters and digits, no @ : / or $.

# Required. The compose file refuses to start when this is empty.
K12_PG_PASSWORD=
K12_PG_DATABASE=k12_trial

# Host port for nginx. postgres and the app are not published.
K12_HTTPS_PORT=8443
# Resolved from docker/compose.trial.yml, so this is the repository var/certs.
# Use ../var/certs or an absolute path. A bare var/certs is treated as a volume name.
K12_CERT_DIR=../var/certs

# Must match the browser origin, including https and the port. * is refused.
K12_CORS_ORIGINS=https://127.0.0.1:8443

# First boot only. Clear both after the admin changes the password.
# Username: 3 to 32 characters, lowercase letters, digits, dot, underscore, hyphen.
# Password: at least 10 characters, with both a letter and a digit.
K12_BOOTSTRAP_ADMIN_USERNAME=
K12_BOOTSTRAP_ADMIN_PASSWORD=

# Empty or mock does not call the network. volcengine needs the three settings below.
K12_AI_PROVIDER=mock
K12_AI_BASE_URL=
K12_AI_MODEL=
K12_AI_API_KEY=
K12_AI_TIMEOUT_SECONDS=60
K12_AI_DAILY_LIMIT=500
K12_AI_REVIEW_THRESHOLD=

K12_PAPER_QR=on
K12_PAPER_LAYOUT_PATH=
# Empty uses the Noto CJK face installed in the trial image.
K12_PDF_FONT_PATH=

# Recorded for the trial. The cleanup job is R10 and does not run yet.
K12_INTAKE_RETENTION_DAYS=30
K12_INTAKE_MAX_BYTES=10485760

# Empty sends nothing. See docs/ops/intake.md.
K12_ERROR_WEBHOOK_URL=

# Host directory for scripts/backup_trial.py when it is not reading the compose volume.
K12_BACKUP_DIR=var/backups
# Set this in the shell that runs the backup. Do not commit a value.
# The compose file does not pass it into the app container.
K12_BACKUP_PASSPHRASE=
