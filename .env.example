# Placeholder values only. Copy to .env locally. Never commit .env.
# The process does not read QBANK_ENV, DATABASE_URL, FILE_ROOT, MODEL_API_KEY, or LOG_LEVEL.
# Identity, audit, catalog, and practice read K12_PG_DSN. An empty K12_PG_DSN keeps the memory adapters.
# scripts/smoke_http.py reads K12_PORT and defaults to 8765. The app itself does not.
QBANK_ENV=local
DATABASE_URL=postgres://qbank:changeme@127.0.0.1:5432/qbank
FILE_ROOT=./var/files
MODEL_API_KEY=your-model-key
LOG_LEVEL=INFO

# development or production. Empty means development. Any other value exits.
# production without K12_PG_DSN, or without K12_FILE_DIR, exits.
# development without K12_PG_DSN stays in memory and logs one warning.
K12_ENV=development

# PostgreSQL. Empty keeps the in-memory adapters in development.
# production without this value exits. A set value migrates identity, audit, catalog, and practice.
# The normalized question tables stay unbuilt.
K12_PG_DSN=postgresql://k12:changeme@127.0.0.1:5432/k12
K12_PG_POOL_MIN=1
K12_PG_POOL_MAX=5

# Page bytes for the DSN path. The files table stores id, purpose, and checksum only.
# production with an empty directory exits. development with an empty directory keeps bytes in memory and logs one warning.
# The process does not read FILE_ROOT.
K12_FILE_DIR=

# Runtime log files. 1 writes JSON Lines under K12_LOG_DIR. Retain days default to 14.
K12_LOG_DIR=./var/log/k12
K12_LOG_FILE=1
K12_LOG_RETAIN_DAYS=14
# Audit rows. 1825 days is 5 * 365.
K12_AUDIT_RETAIN_DAYS=1825
# Session and login-attempt retention. The sweep reads these names. Default 30.
# Learning-record days stay unset.
K12_LOGIN_ATTEMPT_RETAIN_DAYS=30
K12_SESSION_RETAIN_DAYS=30

# Session cookie. Set SECURE=1 only behind HTTPS.
K12_SESSION_SECURE=0
K12_SESSION_IDLE_MINUTES=60
K12_SESSION_ABSOLUTE_HOURS=12

# 1 enables login rate limits. 0 turns them off.
K12_RATE_LIMIT_LOGIN=1

# BOOTSTRAP_* 首启后清空。两者都非空且库里没有 admin 时才创建一次。不要把口令写进日志。
K12_BOOTSTRAP_ADMIN_USERNAME=
K12_BOOTSTRAP_ADMIN_PASSWORD=

# Empty disables the error webhook.
K12_ERROR_WEBHOOK_URL=
