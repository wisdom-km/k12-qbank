{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wisdom-km/k12-qbank/contracts/k12-question-draft.v1.schema.json",
  "version": 1,
  "title": "k12-question-draft v1",
  "description": "一份文件是一页题目草稿。整页 OCR 块列表不是这份契约。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "schema_version", "ok", "reason", "preface", "source", "questions"],
  "properties": {
    "contract": {"const": "k12-question-draft"},
    "contract_version": {"type": "integer", "const": 1},
    "schema_version": {"type": "integer", "const": 1},
    "ok": {"type": "boolean"},
    "reason": {"type": "string"},
    "preface": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdf_page"],
      "properties": {"pdf_page": {"type": ["integer", "null"]}}
    },
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}}
  },
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": false}}, "required": ["ok"]},
      "then": {"properties": {"questions": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "fragment": {
      "oneOf": [
        {
          "description": "文字片段",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {"type": {"const": "text"}, "value": {"type": "string"}}
        },
        {
          "description": "公式片段",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "latex"],
          "properties": {"type": {"const": "math"}, "latex": {"type": "string"}}
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "content"],
      "properties": {
        "key": {"enum": ["A", "B", "C", "D"]},
        "content": {"type": "array", "items": {"$ref": "#/$defs/fragment"}}
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "bbox"],
      "properties": {
        "role": {"const": "crop"},
        "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "section", "number", "type", "structure", "status", "stem", "options", "subquestions", "assets", "geometry"],
      "properties": {
        "key": {"type": "string"},
        "section": {"type": "string"},
        "number": {"type": "string"},
        "type": {"enum": ["single_choice", "multiple_choice", "fill_blank", "solution", "unresolved", "composite"]},
        "structure": {"enum": ["choice", "blank", "worked", "unresolved", "composite"]},
        "status": {"enum": ["candidate", "needs_confirm", "confirmed"]},
        "stem": {"type": "array", "items": {"$ref": "#/$defs/fragment"}},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}},
        "subquestions": {"type": "array", "items": {"$ref": "#/$defs/subquestion"}},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/crop"}},
        "geometry": {"$ref": "#/$defs/geometry"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "single_choice"}}, "required": ["type"]}, "then": {"properties": {"structure": {"const": "choice"}}}},
        {"if": {"properties": {"type": {"const": "multiple_choice"}}, "required": ["type"]}, "then": {"properties": {"structure": {"const": "choice"}}}},
        {"if": {"properties": {"type": {"const": "fill_blank"}}, "required": ["type"]}, "then": {"properties": {"structure": {"const": "blank"}}}},
        {"if": {"properties": {"type": {"const": "solution"}}, "required": ["type"]}, "then": {"properties": {"structure": {"const": "worked"}}}},
        {"if": {"properties": {"type": {"const": "unresolved"}}, "required": ["type"]}, "then": {"properties": {"structure": {"const": "unresolved"}}}},
        {"if": {"properties": {"type": {"const": "composite"}}, "required": ["type"]}, "then": {"properties": {"structure": {"const": "composite"}}}}
      ]
    },
    "subquestion": {
      "oneOf": [
        {
          "description": "沿用大题题型的小问",
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "stem"],
          "properties": {
            "number": {"type": "string"},
            "stem": {"type": "array", "items": {"$ref": "#/$defs/fragment"}}
          }
        },
        {
          "description": "综合题里不带选项的小问",
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "stem", "type", "structure"],
          "properties": {
            "number": {"type": "string"},
            "stem": {"type": "array", "items": {"$ref": "#/$defs/fragment"}},
            "type": {"enum": ["single_choice", "multiple_choice", "fill_blank", "solution"]},
            "structure": {"enum": ["choice", "blank", "worked"]}
          }
        },
        {
          "description": "综合题里带选项的小问",
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "stem", "type", "structure", "options"],
          "properties": {
            "number": {"type": "string"},
            "stem": {"type": "array", "items": {"$ref": "#/$defs/fragment"}},
            "type": {"enum": ["single_choice", "multiple_choice", "fill_blank", "solution"]},
            "structure": {"enum": ["choice", "blank", "worked"]},
            "options": {"type": "array", "items": {"$ref": "#/$defs/option"}}
          }
        }
      ]
    },
    "geometry": {
      "oneOf": [
        {"description": "还没有几何图", "type": "null"},
        {
          "description": "预留的可编辑几何图",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version", "document"],
          "properties": {
            "kind": {"const": "editable-geometry"},
            "version": {"type": "integer", "const": 1},
            "document": {"type": "object"}
          }
        }
      ]
    }
  }
}
