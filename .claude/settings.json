{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)"
    ],
    "ask": [
      "Edit(./scripts/check)",
      "Edit(./scripts/check.ps1)",
      "Edit(./scripts/check.conf)",
      "Edit(./scripts/agent-stop-hook)",
      "Edit(./.github/workflows/**)",
      "Edit(./.pre-commit-config.yaml)",
      "Edit(./.gitleaksignore)",
      "Edit(./docs/WAIVERS.md)",
      "Edit(./.claude/settings.json)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/scripts/agent-stop-hook claude",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
